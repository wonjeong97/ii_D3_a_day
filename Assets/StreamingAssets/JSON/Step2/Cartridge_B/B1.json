          "fontSize": 28,
          "fontColor": {"r": 0.1960784, "g": 0.1960784, "b": 0.1960784, "a": 1},
          "alignment": 0
        },
        "textAnswer5": {
          "name": "Text_A5",
          "position": {"x": -125, "y": 176},
          "scale": {"x": 1, "y": 1, "z": 1},
          "text": "ㅁ. 나를 속인 기분이야",
          "fontName": "font8",
          "fontSize": 28,
          "fontColor": {"r": 0.1960784, "g": 0.1960784, "b": 0.1960784, "a": 1},
          "alignment": 0
