    {
      "questionSetting": {
        "textQuestion": {
          "name": "Text_Q10",
          "position": {"x": 0, "y": 5},
          "scale": {"x": 1, "y": 1, "z": 1},
          "text": "Q10. 네가 나에게 비밀이 있다면",
          "fontName": "font4",
          "fontSize": 55,
          "fontColor": {"r": 0, "g": 0, "b": 0, "a": 1}
        },
        "textAnswer1": {
          "name": "Text_A1",
          "position": {"x": -125, "y": 176},
          "scale": {"x": 1, "y": 1, "z": 1},
          "text": "ㄱ. 이유가 있겠지",
          "fontName": "font8",
          "fontSize": 28,
          "fontColor": {"r": 0.1960784, "g": 0.1960784, "b": 0.1960784, "a": 1},
          "alignment": 0
        },
        "textAnswer2": {
          "name": "Text_A2",
          "position": {"x": -125, "y": 176},
          "scale": {"x": 1, "y": 1, "z": 1},
          "text": "ㄴ. 말해줄 때까지\n기다려",
