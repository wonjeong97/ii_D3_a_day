    {
      "questionSetting": {
        "textQuestion": {
          "name": "Text_Q9",
          "position": {"x": 0, "y": 5},
          "scale": {"x": 1, "y": 1, "z": 1},
          "text": "Q9. 네가 유난히 지쳐 보이는 날에",
          "fontName": "font4",
          "fontSize": 55,
          "fontColor": {"r": 0, "g": 0, "b": 0, "a": 1}
        },
        "textAnswer1": {
          "name": "Text_A1",
          "position": {"x": -125, "y": 176},
          "scale": {"x": 1, "y": 1, "z": 1},
          "text": "ㄱ. 말없이 곁을 지킬게",
          "fontName": "font8",
          "fontSize": 28,
          "fontColor": {"r": 0.1960784, "g": 0.1960784, "b": 0.1960784, "a": 1},
          "alignment": 0
        },
        "textAnswer2": {
          "name": "Text_A2",
          "position": {"x": -125, "y": 176},
          "scale": {"x": 1, "y": 1, "z": 1},
          "text": "ㄴ. 작은 선물을 준비해",
